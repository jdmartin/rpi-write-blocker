# 1. Hardware Level: Force Read-Only immediately on parent storage and NVMe devices
SUBSYSTEM=="block", KERNEL=="sd[a-z]|nvme[0-9]n[0-9]", ACTION=="add", RUN+="/sbin/blockdev --setro /dev/%k"

# 2. Automation Level: Trigger systemd service for all whole disks and partitions (removes flaky conditional flags)
SUBSYSTEM=="block", KERNEL=="sd[a-z][0-9]|sd[a-z]|nvme[0-9]n[0-9]p[0-9]", ACTION=="add", TAG+="systemd", ENV{SYSTEMD_WANTS}="auto-ingest@%k.service"

# 3. Cleanup Level: Unmount and clear loopback on removal
SUBSYSTEM=="block", KERNEL=="sd[a-z]*|nvme[0-9]n[0-9]*", ACTION=="remove", RUN+="/usr/bin/umount -l /mnt/forensic_disk"
SUBSYSTEM=="block", KERNEL=="sd[a-z]*|nvme[0-9]n[0-9]*", ACTION=="remove", RUN+="/usr/sbin/losetup -D"
